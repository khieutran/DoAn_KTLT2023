@page
@using QuanLyCuaHang.Entities
@using QuanLyCuaHang.XuLyNghiepVu
@model QuanLyCuaHang.Pages.MH_HoaDon_BanHangModel
@{
    HoaDonBH[] hoadonban = XL_HoaDon.DocHoaDon_BH();
    if (Request.Method == "POST")
    {
        string TuKhoa = Request.Form["TuKhoa"];
        hoadonban = XL_HoaDon.DocHoaDon_BH(TuKhoa);
    }
}
<a href="MH_Them_HDBan">Thêm</a>
<div class="text-center">
    <form method="post">
        <label for="fname">TuKhoa:</label><br>
        <input id="fname" type="text" name="TuKhoa" value=""><br>
        <input type="submit" value="Tìm Kiếm">
    </form>
</div>
<style>
    table {
        font-family: arial, sans-serif;
        border-collapse: collapse;
        width: 100%;
    }

    td, th {
        border: 1px solid #dddddd;
        text-align: left;
        padding: 8px;
    }

    tr:nth-child(even) {
        background-color: #dddddd;
    }
</style>
<table style="width:100%">
    <tr>
        <th>MÃ HÓA ĐƠN</th>
        <th>NGÀY TẠO HÓA ĐƠN</th>
        <th>MẶT HÀNG</th>
        <th>LOẠI HÀNG</th>
        <th>SỐ LƯỢNG</th>
        <th>GIÁ TIỀN</th>
        <th>ACTION</th>
    </tr>
    @if (hoadonban.Length > 0)
    {
        @foreach (HoaDonBH HoaDon_BH in hoadonban)
        {
            <tr>
                <td>@HoaDon_BH.MaHD_BH</td>
                <td>@HoaDon_BH.NgayTaoHD_Ban</td>
                <td>@HoaDon_BH.MatHang</td>
                <td>@HoaDon_BH.LoaiHang</td>
                <td>@HoaDon_BH.SL</td>
                <td>@HoaDon_BH.Gia</td>
                <td>
                    <a href="MH_Sua_HDBan?MaHD_Ban=@HoaDon_BH.MaHD_BH">Sửa</a>
                    <a href="MH_Xoa_HDBan?MaHD_Ban=@HoaDon_BH.MaHD_BH">Xóa</a>
                </td>
            </tr>
        }
    }
</table>
@if (hoadonban == null)
{
    <div>Khong co ket qua tuong ung</div>
}