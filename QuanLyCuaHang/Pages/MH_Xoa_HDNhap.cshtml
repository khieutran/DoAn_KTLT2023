@page
@using QuanLyCuaHang.Entities
@using QuanLyCuaHang.XuLyNghiepVu
@model QuanLyCuaHang.Pages.MH_Xoa_SanPhamModel
@{
    string chuoi = string.Empty;
    string MaHD_Nhap = Request.Query["MaHD_Nhap"];
    HoaDonNH? n = null;
    if (!string.IsNullOrEmpty(MaHD_Nhap))
    {
        n = XL_HoaDon.DocChiTiet_HDNhap(MaHD_Nhap);
        if (n == null)
        {
            chuoi = "Hóa đơn không tồn tại";
        }
        else
        {
            if (Request.Method == "POST")
            {
                string kq = XL_HoaDon.XoaHD_Nhap(MaHD_Nhap);
                chuoi = kq;
                if (string.IsNullOrEmpty(chuoi))
                {
                    Response.Redirect("MH_HoaDon_BanHang");
                }
            }
        }
    }
    else
    {
        chuoi = "Không có tham số mã hóa đơn";
    }
}
<div class="text-center">
    @if (n != null)
    {
        <div>Bạn có muốn xóa hóa đơn nhập hàng có mã <div>@n.MaHD_NH</div> ngày <div>@n.NgayTaoHD_Nhap</div> không? </div>
        <form method="post">
            <input type="submit" value="Xóa">
        </form>
    }
    else
    {
        <div>@chuoi</div>
    }
</div>
